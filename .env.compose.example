# Copy to .env.compose (ignored). Use fresh hex secrets; never commit real values.
# Generate each separately: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POSTGRES_PASSWORD=
JWT_SECRET=
# Production with Docker Compose + Caddy:
APP_ORIGIN=https://example.com
APP_HOST=example.com
NODE_ENV=production
LOCAL_PORT=3001
# Local test without the https profile: APP_ORIGIN=http://localhost:3001 and NODE_ENV=development.
