# PostgreSQL is required for the live backend. Never point tests at production.
DATABASE_URL="postgresql://veilnivo:change-me@localhost:5432/veilnivo?schema=public"
JWT_SECRET="replace-with-at-least-32-cryptographically-random-bytes"
CLIENT_ORIGIN="http://localhost:3000"
HOST="127.0.0.1"
PORT="3001"
SERVE_FRONTEND="false"
FRONTEND_DIR="out"
# Trust only the addresses of your reverse proxy; default false ignores forwarded IPs.
TRUST_PROXY="false"
# Local split frontend/API. The Docker image uses same-origin mode automatically.
# Modes: demo, same-origin, remote. Changing these requires a frontend rebuild.
NEXT_PUBLIC_API_MODE="remote"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Ollama Cloud is selected but inactive. It is currently metered, not a
# guaranteed free API. Keep disabled until approving usage costs and supplying
# a model and server API key. A key alone never enables cloud inference.
# No secret belongs in NEXT_PUBLIC_* variables or browser code.
AI_PROVIDER="ollama"
OLLAMA_CLOUD_ENABLED="false"
OLLAMA_API_KEY=""
OLLAMA_MODEL=""

# Legacy OpenAI-compatible provider. Select AI_PROVIDER=openai-compatible.
# Keep disabled until provider configuration and a retention agreement are verified.
BOT_API_URL="https://api.openai.com/v1/chat/completions"
BOT_API_KEY=""
BOT_MODEL=""
BOT_ZERO_RETENTION_CONFIRMED="false"
